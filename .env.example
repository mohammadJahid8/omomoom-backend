# Copy this file to `.env` and fill in real values.
#   cp .env.example .env

NODE_ENV=development
PORT=5001

# Postgres connection string.
#   - Local docker-compose (this repo):  postgresql://omomoom:omomoom@localhost:5433/omomoom?schema=public
#   - Neon / Supabase / Railway:         paste the connection string they give you
DATABASE_URL="postgresql://omomoom:omomoom@localhost:5433/omomoom?schema=public"

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

BCRYPT_SALT_ROUNDS=12

# Generate real secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-me-with-another-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Rate limiting: max requests per IP per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# --- File storage (Cloudflare R2) -----------------------------------------
# All five are required together. Leave them blank and uploads answer 503
# instead of the server refusing to start.
# Account ID and the bucket name come from the R2 dashboard; the key pair
# comes from "Manage R2 API Tokens".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Where files are read from. The bucket's r2.dev URL while developing, then
# your own domain (https://media.omomoom.com) in production.
R2_PUBLIC_URL=
