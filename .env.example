# Copy this file to `.env` and fill in real values.
#   cp .env.example .env

NODE_ENV=development
PORT=5001

# Postgres connection string.
#   - Local docker-compose (this repo):  postgresql://omomoom:omomoom@localhost:5433/omomoom?schema=public
#   - Neon / Supabase / Railway:         paste the connection string they give you
DATABASE_URL="postgresql://omomoom:omomoom@localhost:5433/omomoom?schema=public"

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

BCRYPT_SALT_ROUNDS=12

# --- Billing (Stripe) ------------------------------------------------------
# All three are required together. Leave them blank and billing falls back to
# the mock provider, which charges nothing and marks the month as paid.
# Create the product and price with:  npm run stripe:setup
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the endpoint's signing secret when deployed.
STRIPE_WEBHOOK_SECRET=
